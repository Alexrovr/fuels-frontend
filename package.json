{
  "name": "fuels-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate-api": "node scripts/generate-api.mjs",
    "build:pages": "tsc -b && vite build --mode pages",
    "dev:https": "vite --mode local-https",
    "preview:https": "vite preview --mode local-https",
    "certs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-certs.ps1",
    "deploy": "npm run build:pages && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
